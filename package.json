{
  "name": "work-orders-dashboard",
  "version": "0.0.0",
  "scripts": {
    "start": "concurrently \"npm run server\" \"ng serve --port 4200\"",
    "server": "json-server --watch db.json --port 3000",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --no-progress --browsers=ChromeHeadlessCI",
    "lint": "ng lint",
    "generate-data": "tsx scripts/generate-data.ts"
  },
  "private": true,
  "packageManager": "npm@12.0.1",
  "dependencies": {
    "@angular/cdk": "^22.1.3",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.1.3",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.0",
    "concurrently": "^10.0.5",
    "jsdom": "^28.0.0",
    "json-server": "^1.0.0-beta.15",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "tsx": "^4.19.2",
    "vitest": "^4.0.8"
  }
}
